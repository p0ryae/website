{
  "name": "website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint ."
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iconify/svelte": "^5.2.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@types/node": "^24",
    "@yarnpkg/sdks": "^3.3.1",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.3.0",
    "jiti": "^2.7.0",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "svelte-language-server": "^0.18.6",
    "typescript": "^6",
    "typescript-eslint": "^8.54.0",
    "vite": "^8"
  },
  "resolutions": {
    "@yarnpkg/core@npm:^4.9.1": "npm:4.9.1"
  },
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "@sveltejs/kit@3.3.1": {
      "unplugged": true
    }
  }
}
